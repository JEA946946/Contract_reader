# =============================================================
#  Database
# =============================================================
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/hotelprice_reader

# =============================================================
#  Anthropic API (required for AI extraction)
# =============================================================
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# =============================================================
#  File uploads
# =============================================================
UPLOAD_DIR=uploads

# =============================================================
#  Gmail polling (optional — auto-import contracts from inbox)
# =============================================================
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_POLL_INTERVAL_MINUTES=15
GMAIL_POLL_ENABLED=false

# =============================================================
#  CMR API integration (optional)
# =============================================================
CMR_API_BASE=
CMR_API_TOKEN=

# =============================================================
#  CORS allowed origins (comma-separated)
# =============================================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,http://localhost:8005

# =============================================================
#  AI parser tuning
# =============================================================
# Set to true to re-enable the separate validation pass (Pass 3).
# Disabled by default — validation is now inline in Pass 2.
AI_VALIDATION_PASS_ENABLED=false
